{
  "name": "lumontime",
  "author": "Nick Pappas",
  "version": "1.2.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "scripts": {
    "lint:ast": "ast-grep scan src",
    "test:ast": "ast-grep test",
    "outline": "ast-grep outline --outline-rules outline-rules/c.yml --outline-rules outline-rules/javascript.yml --items structure",
    "outline:json": "ast-grep outline --outline-rules outline-rules/c.yml --outline-rules outline-rules/javascript.yml --items structure --json=stream"
  },
  "pebble": {
    "displayName": "LumonTime",
    "uuid": "d4f1bc4c-e298-4f23-9428-2114f4f53b1d",
    "projectType": "native",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "configurable"
    ],
    "messageKeys": [
      "ANIM_MODE"
    ],
    "resources": {
      "media": [
        {
          "type": "png",
          "menuIcon": true,
          "name": "IMAGE_MENU_ICON",
          "file": "images/menu_icon.png"
        }
      ]
    }
  },
  "dependencies": {
    "@rebble/clay": "^1.0.10"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.44.0"
  },
  "allowScripts": {
    "@ast-grep/cli@0.44.0": true
  }
}
